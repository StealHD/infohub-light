{
  "version": "1.0",
  "ai": {
    "enabled": true,
    "provider": "openai",
    "model": "gpt-4",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 4096,
    "throttle_sec": 0,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "analysis_content_chars": 1000,
    "analysis_comments_chars": 1500,
    "enrichment_content_chars": 4000,
    "languages": [
      "zh"
    ]
  },
  "tags": [
    "AI Agent",
    "AI 编程",
    "模型发布",
    "RAG/MCP",
    "AI Infra",
    "开源模型",
    "推理框架",
    "产品创业",
    "研究论文",
    "安全治理",
    "行业动态"
  ],
  "personal_tags": [
    "价格监控",
    "能黄通"
  ],
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "torvalds",
        "enabled": true,
        "tags": [
          "行业动态"
        ]
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true,
        "tags": [
          "AI 编程"
        ]
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 100
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "tags": [
          "AI 编程",
          "RAG/MCP"
        ]
      },
      {
        "name": "LWN.net (subscriber full-text)",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": false,
        "category": "linux"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 50,
          "tags": [
            "研究论文",
            "行业动态"
          ]
        }
      ],
      "users": [
        {
          "username": "iamthatis",
          "enabled": true,
          "sort": "new",
          "fetch_limit": 10,
          "tags": [
            "行业动态"
          ]
        }
      ],
      "fetch_comments": 5
    },
    "twitter": {
      "enabled": false,
      "apify_token_env": "APIFY_TOKEN",
      "users": [
        "karpathy",
        "ylecun"
      ],
      "fetch_limit": 10,
      "fetch_reply_text": false,
      "max_replies_per_tweet": 3,
      "max_tweets_to_expand": 10,
      "reply_min_likes": 5
    },
    "apify_social": {
      "enabled": false,
      "token_env": "APIFY_TOKEN",
      "token_envs": [
        "APIFY_TOKEN",
        "APIFY_TOKEN_2",
        "APIFY_TOKEN_3"
      ],
      "timeout_seconds": 180,
      "actors": {
        "x": {
          "actor_id": "xquik/x-tweet-scraper"
        },
        "instagram": {
          "actor_id": "apify/instagram-api-scraper"
        },
        "facebook": {
          "actor_id": "whoareyouanas/facebook-group-scraper"
        },
        "telegram": {
          "actor_id": "thescrapelab/apify-telegram-scraper"
        }
      },
      "subscriptions": [
        {
          "platform": "x",
          "kind": "profile",
          "target": "OpenAI",
          "fetch_limit": 20,
          "enabled": true,
          "tags": [
            "AI Agent",
            "模型发布",
            "行业动态"
          ]
        },
        {
          "platform": "instagram",
          "kind": "hashtag",
          "target": "#aiagents",
          "fetch_limit": 20,
          "enabled": true,
          "tags": [
            "AI Agent",
            "产品创业"
          ]
        },
        {
          "platform": "instagram",
          "kind": "profile",
          "target": "tsucha_ri",
          "fetch_limit": 1,
          "enabled": true,
          "tags": [
            "行业动态"
          ],
          "personal_tags": [
            "能黄通"
          ],
          "analysis_mode": "personal_only"
        },
        {
          "platform": "facebook",
          "kind": "page",
          "target": "https://www.facebook.com/openai",
          "fetch_limit": 20,
          "enabled": true,
          "tags": [
            "模型发布",
            "行业动态"
          ]
        },
        {
          "platform": "telegram",
          "kind": "channel",
          "target": "zaihuapd",
          "fetch_limit": 20,
          "enabled": true,
          "tags": [
            "产品创业",
            "行业动态"
          ]
        }
      ]
    },
    "openbb": {
      "enabled": false,
      "fetch_filings": false,
      "filings_provider": "sec",
      "watchlists": [
        {
          "name": "megacaps",
          "enabled": true,
          "provider": "yfinance",
          "fetch_limit": 20,
          "category": "equities",
          "symbols": [
            "AAPL",
            "MSFT",
            "NVDA",
            "GOOGL",
            "AMZN",
            "META",
            "TSLA"
          ]
        }
      ]
    },
    "ossinsight": {
      "enabled": false,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript"
      ],
      "keywords": [],
      "min_stars": 10,
      "max_items": 30
    }
  },
  "filtering": {
    "ai_score_threshold": 7.5,
    "featured_score_threshold": 7.5,
    "daily_push_score_threshold": 8.5,
    "daily_push_limit": 10,
    "homepage_min_score": 6,
    "time_window_hours": 24,
    "recent_item_limit": 20
  }
}
