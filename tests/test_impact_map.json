{
  "version": 1,
  "docs_only_globs": [
    "*.md",
    "deploy/*.md",
    "docs/*.md",
    "docs/**/*.md",
    "src/mcp/*.md"
  ],
  "full_globs": [
    ".github/workflows/*",
    ".dockerignore",
    ".env.example",
    "Dockerfile",
    "docker-compose*.yml",
    "deploy/*.compose.yml",
    "project-controls.json",
    "project-defaults.yaml",
    "pyproject.toml",
    "tests/conftest.py",
    "tests/test_impact_map.json",
    "uv.lock"
  ],
  "fail_closed_globs": [
    "*.py",
    "*.sh",
    "src/**",
    "scripts/**",
    "tests/**",
    "frontend/**",
    "deploy/**"
  ],
  "ui_globs": [
    "UI_CONTRACT.md",
    "src/ui/**",
    "frontend/**",
    "tests/*.test.cjs"
  ],
  "rules": [
    {
      "id": "observability logging",
      "globs": [
        "src/logging_utils.py",
        "src/main.py",
        "src/services/email.py",
        "src/services/operation_log.py",
        "src/services/webhook.py",
        "tests/test_api_operation_logging.py",
        "tests/test_logging_utils.py",
        "tests/test_operation_log.py"
      ],
      "groups": ["python_api_store"]
    },
    {
      "id": "API/store",
      "globs": [
        "src/api/**/*.py",
        "src/api/*.py",
        "src/storage/**/*.py",
        "src/storage/*.py",
        "src/services/apify_actor_alerts.py",
        "src/services/apify_actor_monitoring.py",
        "src/services/apify_actor_route.py",
        "src/services/apify_key_pool.py",
        "src/services/secret_store.py",
        "src/services/agent_change_proposal.py",
        "src/services/*notification*.py",
        "src/rsshub.py",
        "src/services/source_type_registry.py",
        "src/services/source_resolution.py",
        "src/services/subscription_mutation.py",
        "src/services/user_config_builder.py",
        "src/services/user_content_store.py",
        "src/services/user_item_state.py",
        "src/services/youtube_channel.py",
        "tests/test_apify_actor_alert_api.py",
        "tests/test_apify_actor_alerts.py",
        "tests/test_apify_actor_route.py",
        "tests/test_apify_actor_route_api.py",
        "tests/test_migrate_apify_actor_routing_v13.py",
        "tests/test_source_resolution.py",
        "tests/test_youtube_channel.py"
      ],
      "groups": ["python_api_store"]
    },
    {
      "id": "Remote MCP/OpenClaw",
      "globs": [
        "src/mcp/remote_*.py",
        "src/services/bilibili_user_search.py",
        "src/services/source_resolution.py",
        "frontend/src/features/openclaw/**",
        "frontend/src/features/admin-heroui/HeroAgentsPage*",
        "scripts/remote_mcp_read_canary.py",
        "scripts/setup_openclaw_local.py",
        "scripts/setup_openclaw_local.sh",
        "integrations/openclaw/inteliscope/**",
        "tests/test_remote_mcp_read_canary.py",
        "tests/test_remote_mcp_rollout_runbook.py",
        "tests/test_remote_mcp_subscription_service.py",
        "tests/test_remote_mcp_subscription_http.py",
        "tests/test_remote_mcp_diagnostics.py",
        "tests/test_bilibili_user_search.py",
        "tests/test_openclaw_skill.py",
        "tests/test_setup_openclaw_local.py",
        "tests/test_source_resolution.py",
        "deploy/nginx/inteliscope-basic-auth.conf",
        "deploy/nginx/inteliscope-rate-limit.conf",
        "deploy/nginx-rsshub-location.conf"
      ],
      "groups": ["python_api_store"]
    },
    {
      "id": "queue/worker",
      "globs": [
        "src/services/feed_schedule.py",
        "src/services/apify_actor_alerts.py",
        "src/services/apify_actor_monitoring.py",
        "src/services/apify_actor_route.py",
        "src/services/apify_pool_runtime.py",
        "src/services/job_eligibility.py",
        "src/services/job_queue.py",
        "src/services/*notification*.py",
        "src/services/quota.py",
        "src/services/runtime_status.py",
        "src/services/scheduler.py",
        "src/services/source_schedule.py",
        "src/services/usage_attempt_meter.py",
        "src/services/worker.py"
      ],
      "groups": ["python_queue_worker"]
    },
    {
      "id": "Feed",
      "globs": [
        "src/services/article_*.py",
        "src/services/canonical_content.py",
        "src/services/content_repair.py",
        "src/services/content_presentation.py",
        "src/services/feed_*.py",
        "src/services/legacy_publisher.py",
        "src/services/maintenance.py",
        "src/services/media_cache.py",
        "src/services/network_policy.py",
        "src/services/response_schema.py",
        "src/services/source_avatar.py",
        "src/services/user_analysis_cache.py",
        "src/services/user_feed_store.py",
        "tests/test_feed_end_messages.py"
      ],
      "groups": ["python_feed"]
    },
    {
      "id": "source acquisition",
      "globs": [
        "src/services/catalog_source_runner.py",
        "src/services/apify_actor_route.py",
        "src/services/source_acquisition.py",
        "src/services/source_health.py",
        "src/services/source_update.py"
      ],
      "groups": ["python_source_acquisition"]
    },
    {
      "id": "AI/orchestrator",
      "globs": [
        "src/ai/**/*.py",
        "src/ai/*.py",
        "src/models.py",
        "src/orchestrator.py",
        "src/source_selection.py",
        "src/tag_policy.py"
      ],
      "groups": ["python_ai_orchestrator"]
    },
    {
      "id": "scrapers",
      "globs": ["src/scrapers/**/*.py", "src/scrapers/*.py"],
      "groups": ["python_scrapers"]
    },
    {
      "id": "Python UI",
      "globs": ["src/ui/**/*.py", "src/ui/*.py"],
      "groups": ["python_ui"]
    },
    {
      "id": "scripts",
      "globs": [
        "scripts/*.py",
        "scripts/*.sh",
        "tests/test_migrate_apify_actor_routing_v13.py",
        "tests/test_migrate_rsshub_sources.py"
      ],
      "groups": ["python_scripts"]
    },
    {
      "id": "legacy UI behavior",
      "globs": ["src/ui/static/*.js"],
      "groups": ["legacy_ui"]
    },
    {
      "id": "legacy UI contract",
      "globs": ["src/ui/static/*.css", "src/ui/static/*.html"],
      "groups": ["legacy_ui_contract"]
    },
    {
      "id": "React related",
      "globs": [
        "frontend/src/*.css",
        "frontend/src/*.ts",
        "frontend/src/*.tsx",
        "frontend/src/**/*.css",
        "frontend/src/**/*.ts",
        "frontend/src/**/*.tsx"
      ],
      "groups": ["frontend_checks", "frontend_related"]
    },
    {
      "id": "React global Shell",
      "globs": [
        "frontend/src/AppBootstrap.test.tsx",
        "frontend/src/AppBootstrap.tsx",
        "frontend/src/app/App.tsx",
        "frontend/src/app/ActionFeedback.tsx",
        "frontend/src/design-system/**",
        "frontend/src/features/workbench-live/**",
        "frontend/src/main.tsx",
        "frontend/src/styles/**",
        "frontend/src/test/setup.ts"
      ],
      "groups": ["frontend_full"]
    },
    {
      "id": "React UI contract (UI_CONTRACT.md authority)",
      "globs": [
        "UI_CONTRACT.md",
        "frontend/scripts/check-preview-build.mjs",
        "frontend/scripts/check-ui-contract.mjs",
        "frontend/src/design-system/**"
      ],
      "groups": ["frontend_full"]
    },
    {
      "id": "React global configuration",
      "globs": [
        "frontend/eslint.config.*",
        "frontend/index.html",
        "frontend/package-lock.json",
        "frontend/package.json",
        "frontend/playwright.config.*",
        "frontend/tsconfig*.json",
        "frontend/vite.config.*",
        "frontend/vitest.config.*"
      ],
      "groups": ["frontend_full"]
    },
    {
      "id": "React E2E",
      "globs": [
        "frontend/e2e/**/*.png",
        "frontend/e2e/**/*.ts",
        "frontend/e2e/*.ts"
      ],
      "groups": ["frontend_full"]
    }
  ],
  "group_tests": {
    "python_api_store": [
      "tests/test_agent_delegation_api.py",
