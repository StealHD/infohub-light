  "e2e_rules": [
    {
      "id": "ActorOps",
      "globs": [
        "frontend/src/features/apify-actors/**",
        "frontend/e2e/actorops-pool-management.spec.ts",
        "frontend/e2e/actorops-pool-management.spec.ts-snapshots/**"
      ],
      "specs": [
        "e2e/actorops-pool-management.spec.ts",
        "e2e/production-admin.spec.ts"
      ]
    },
    {
      "id": "Workbench",
      "globs": [
        "frontend/src/features/workbench-heroui/**",
        "frontend/src/features/workbench-live/**",
        "frontend/e2e/heroui-workbench-preview.spec.ts",
        "frontend/e2e/production-workbench.spec.ts",
        "frontend/e2e/production-workbench.spec.ts-snapshots/**"
      ],
      "specs": [
        "e2e/heroui-workbench-preview.spec.ts",
        "e2e/production-workbench.spec.ts"
      ]
    },
    {
      "id": "Settings",
      "globs": [
        "frontend/src/features/admin-heroui/**",
        "frontend/src/features/settings/**",
        "frontend/src/features/notifications/**",
        "frontend/e2e/production-admin.spec.ts",
        "frontend/e2e/production-admin.spec.ts-snapshots/**"
      ],
      "specs": ["e2e/production-admin.spec.ts"]
    },
    {
      "id": "Design system visual",
      "globs": [
        "frontend/e2e/design-system-contract.spec.ts",
        "frontend/e2e/design-system-contract.spec.ts-snapshots/**"
      ],
      "specs": ["e2e/design-system-contract.spec.ts"]
    }
