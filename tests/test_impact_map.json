{
  "version": 2,
  "docs_only_globs": [
    "*.md",
    "deploy/*.md",
    "docs/*.md",
    "docs/**/*.md",
    "src/mcp/*.md"
  ],
  "full_globs": [
    ".github/workflows/*",
    ".dockerignore",
    ".env.example",
    "Dockerfile",
    "docker-compose*.yml",
    "deploy/*.compose.yml",
    "project-controls.json",
    "project-defaults.yaml",
    "pyproject.toml",
    "scripts/check_code_size.py",
    "scripts/code_size_policy.py",
    "scripts/code_size_ts_ast.mjs",
    "scripts/test_gate_changes.py",
    "scripts/test_gate_log.py",
    "src/__init__.py",
    "tests/test_code_size.py",
    "tests/conftest.py",
    "tests/test_impact_map.json",
    "uv.lock"
