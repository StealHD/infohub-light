  "fail_closed_globs": [
    "*.py",
    "*.sh",
    "src/**",
    "scripts/**",
    "tests/**",
    "frontend/**",
    "deploy/**"
  ],
  "ui_globs": [
    "docs/contracts/ui/**",
    "frontend/**"
  ],
  "e2e_all_globs": [
    "docs/contracts/ui/**",
    "frontend/index.html",
    "frontend/package*.json",
    "frontend/playwright*.ts",
    "frontend/src/AppBootstrap*",
    "frontend/src/app/**",
    "frontend/src/design-system/**",
    "frontend/src/main.tsx",
    "frontend/src/styles/**",
    "frontend/vite.config.*"
