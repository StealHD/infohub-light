# Environment Variables

# AI API Keys (configure the one matching data/config.json ai.provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
GOOGLE_API_KEY=
XIAOMI_API_KEY=
MINIMAX_API_KEY=
DASHSCOPE_API_KEY=
DOUBAO_API_KEY=
DEEPSEEK_API_KEY=

# Scheduler
HORIZON_TIMEZONE=Asia/Shanghai
HORIZON_DAILY_TIME=08:30
HORIZON_FETCH_HOURS=24
HORIZON_RUN_ON_START=true
HORIZON_POLL_ENABLED=true
HORIZON_POLL_INTERVAL_MINUTES=30
HORIZON_POLL_FETCH_HOURS=2
HORIZON_WEB_BIND=127.0.0.1
HORIZON_WEB_PORT=8080
# Private runtime/operation JSONL files rotate daily in UTC.
HORIZON_LOG_LEVEL=INFO
HORIZON_LOG_RETENTION_DAYS=30
HORIZON_REMOTE_MCP_ENABLED=false
# Required when enabled. Loopback may use HTTP; non-loopback must use HTTPS and end at /mcp.
HORIZON_REMOTE_MCP_PUBLIC_URL=
# Keep false for a read-only production rollout. Enabling requires a separate authorization.
HORIZON_REMOTE_MCP_SUBSCRIPTION_WRITES_ENABLED=false
# Browser-to-OpenClaw Gateway chat. Keep disabled until Chromium pairing is verified.
HORIZON_OPENCLAW_CHAT_ENABLED=false
# Plain ws:// is accepted only for loopback. Remote Gateways must use wss://.
HORIZON_OPENCLAW_GATEWAY_DEFAULT_URL=ws://127.0.0.1:18789

# Worker / user-controlled RSS egress policy
HORIZON_SCHEDULE_POLL_SECONDS=30
# WAL is the native/Linux default. Use DELETE when API and Worker share a macOS Docker bind mount.
HORIZON_SQLITE_JOURNAL_MODE=WAL
HORIZON_WORKER_LEASE_SECONDS=900
HORIZON_WORKER_RETRY_BASE_SECONDS=30
HORIZON_JOB_RETENTION_DAYS=14
# Service admission limits. Fetch/AI attempts count real upstream calls, including retries.
INFOHUB_MAX_FETCH_JOBS_PER_DAY=100
INFOHUB_MAX_SOURCES_PER_USER=100
INFOHUB_MAX_AI_ITEMS_PER_DAY=1000
INFOHUB_MAX_WORKSPACE_AI_ATTEMPTS_PER_DAY=1000
INFOHUB_MAX_WORKSPACE_FETCH_ATTEMPTS_PER_DAY=100
INFOHUB_MAX_PROVIDER_FETCH_ATTEMPTS_PER_DAY=100

# Rollout flags remain off until additive schema/migration verification is complete.
HORIZON_APIFY_KEY_POOL_ENABLED=false
HORIZON_SHARED_ACQUISITION_ENABLED=false
HORIZON_SHARED_ACQUISITION_MIN_TTL_MINUTES=5
HORIZON_SHARED_ACQUISITION_MAX_TTL_MINUTES=60
HORIZON_SHARED_ACQUISITION_FALLBACK_TTL_MINUTES=30
HORIZON_COMPACT_FEED_SNAPSHOTS_ENABLED=false

# Hourly bounded retention. The latest Feed/source snapshot is always preserved.
HORIZON_MAINTENANCE_INTERVAL_SECONDS=3600
HORIZON_FEED_SNAPSHOT_RETENTION_DAYS=90
HORIZON_MAX_FEED_SNAPSHOTS_PER_USER=100
HORIZON_SOURCE_CONTENT_RETENTION_DAYS=7
HORIZON_ANALYSIS_CACHE_RETENTION_DAYS=30
HORIZON_USAGE_RETENTION_DAYS=90
# Empty by default. Admins may list exact hosts (comma-separated) for deterministic local RSS fixtures.
HORIZON_MEMBER_RSS_HOST_ALLOWLIST=

# Web/admin auth
# Service API always requires an owner login. Before starting Compose, set either
# HORIZON_AUTH_PASSWORD or HORIZON_AUTH_PASSWORD_HASH to a non-empty value.
# HORIZON_AUTH_ENABLED only controls the legacy horizon-web service; false does not open horizon-api.
HORIZON_AUTH_ENABLED=false
HORIZON_AUTH_USER=admin
# REQUIRED for quick private testing unless HORIZON_AUTH_PASSWORD_HASH is set.
# For sharing, prefer HORIZON_AUTH_PASSWORD_HASH generated by:
#   docker compose run --rm --entrypoint sh horizon -lc "python -m src.ui.auth hash-password 'change-me'"
HORIZON_AUTH_PASSWORD=
HORIZON_AUTH_PASSWORD_HASH=
HORIZON_AUTH_SESSION_SECRET=
HORIZON_AUTH_SESSION_TTL_SECONDS=604800
HORIZON_AUTH_SECURE_COOKIE=false

# Immutable service image identity. Release tooling overrides these values.
INTELISCOPE_IMAGE=inteliscope-service:local
INTELISCOPE_VERSION=1.7.3
INTELISCOPE_BUILD_REVISION=unknown
INTELISCOPE_BUILT_AT=unknown

# Local Docker rebuild helper (used by ./scripts/up-latest.sh)
HORIZON_BUILD_NO_CACHE=true
HORIZON_PRUNE_OLD_IMAGES=true
HORIZON_PRUNE_BUILD_CACHE=true
HORIZON_PRUNE_BUILD_CACHE_UNTIL=24h

# Webhook URL for Feishu, DingTalk, Telegram bridge, Slack, Discord, or generic webhook.
# Keep webhook.enabled=false in data/config.json until this is configured.
HORIZON_WEBHOOK_URL=

# GitHub Token (optional but recommended for higher rate limits)
# Without token: 60 requests/hour
# With token: 5000 requests/hour
GITHUB_TOKEN=

# Apify Token (required when sources.apify_social.enabled=true or sources.twitter.enabled=true)
APIFY_TOKEN=
APIFY_TOKEN_2=
APIFY_TOKEN_3=

# Email delivery (optional)
EMAIL_PASSWORD=
